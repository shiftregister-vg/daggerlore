# deployed to Node hosting
PUBLIC_ORIGIN=
MAINTENANCE_MODE=
ADMIN_USER_ID=
ADMIN_EMAIL=
BODY_SIZE_LIMIT=10M
# Production: postgres://user:password@host:5432/db
# Local SQLite: file:./data/local.db
DATABASE_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Feedback Manager GitHub App integration
GITHUB_FEEDBACK_ENABLED=false
# Enable only on the environment receiving the GitHub App webhook (normally production).
GITHUB_FEEDBACK_WEBHOOKS_ENABLED=false
GITHUB_REPOSITORY=shiftregister-vg/daggerlore
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM content may be multiline or use escaped \n characters.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# for local development only
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
