{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "Dockerfile.web",
		"watchPatterns": [
			"/package.json",
			"/package-lock.json",
			"/svelte.config.js",
			"/vite.config.ts",
			"/tsconfig.json",
			"/src/**",
			"/static/**",
			"/public/**",
			"/drizzle/**",
			"/drizzle.config.ts"
		]
	},
	"deploy": {
		"startCommand": "node build"
	}
}
