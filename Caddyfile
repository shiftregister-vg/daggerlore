{
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
	}
}

:{$PORT:8080} {
	encode zstd gzip

	@api path /api/rest /api/rest/*
	handle @api {
		# Railway can override this with a private-network upstream, e.g. api.railway.internal:3000.
		reverse_proxy {$DAGGERLORE_API_UPSTREAM:daggerlore-api.railway.internal:3000}
	}

	handle {
		# Local devenv overrides this to Vite on 5173; Railway web currently listens on 8080.
		reverse_proxy {$DAGGERLORE_WEB_UPSTREAM:daggerlore.railway.internal:8080}
	}
}
